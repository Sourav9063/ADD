      "Bash(umount *)",
      "Bash(passwd *)",
      "Bash(dscl *)",
      "Bash(useradd *)",
      "Bash(userdel *)",
      "Bash(usermod *)",
      "Bash(visudo *)",
      "Bash(defaults write *)",
      "Bash(csrutil *)",
      "Bash(spctl *)",
      "Bash(pmset *)",
