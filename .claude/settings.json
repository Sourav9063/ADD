{
  "syncClaudeAiSkills": false,
  "skillOverrides": {
    "dataviz": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "loop": "off",
    "schedule": "off",
    "run": "user-invocable-only",
    "init": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "security-review": "user-invocable-only",
    "update-config": "user-invocable-only",
    "keybindings-help": "user-invocable-only"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
    "CLAUDE_CODE_HIDE_SETTINGS_HINT": "1"
  },
  "skillListingMaxDescChars": 400,
  "autoDreamEnabled": false,
  "agentPushNotifEnabled": false,
  "spinnerTipsEnabled": false,
  "promptSuggestionEnabled": false,
  "disableDeepLinkRegistration": "disable",
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList",
      "Agent",
      "ListAgents"
    ],
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "disableAgentView": true,
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true,
  "model": "opus"
}
