      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git config *)",
      "Bash(git remote *)",
      "Bash(git submodule *)",
      "Bash(git filter-branch *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm publish *)",
      "Bash(npx *)",
